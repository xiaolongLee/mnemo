# PostgreSQL 连接串。本地 Docker 示例：postgresql://postgres:postgres@localhost:5432/mnemo
DATABASE_URL=

# Google AI Studio 的 Gemini API Key，聊天和 embedding 共用
GOOGLE_GENERATIVE_AI_API_KEY=

# 可选。聊天模型，默认 gemini-3.8-flash
GOOGLE_CHAT_MODEL_ID=

# 可选。向量模型，默认 gemini-embedding-001，输出维度由代码里的 EMBEDDING_DIMENSIONS 决定
GOOGLE_EMBEDDING_MODEL_ID=

# 可选。中转地址，默认 https://generativelanguage.googleapis.com/v1beta
GOOGLE_GENERATIVE_AI_BASE_URL=

# 演示用户，不做登录
DEFAULT_USER_ID=demo-user
